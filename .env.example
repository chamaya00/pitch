# Copy to .env and fill in. Never commit .env.
#
# The backend reads this file (repo root or backend/.env) via pydantic-settings.
# The frontend only ever sees NEXT_PUBLIC_* variables.

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. Required since Step 7M: it is the source of truth for
# recordings, analyses and owners. The API applies its migrations at startup
# and refuses to serve recording endpoints without it.
DATABASE_URL=postgresql://vocallens:vocallens@localhost:5432/vocallens

# Optional, tests only. When set, the PostgreSQL test suites run against it
# instead of skipping. It is TRUNCATEd between tests — point it at a scratch
# database, never at one holding anything you want to keep.
TEST_DATABASE_URL=

# --- Speech analysis providers ---------------------------------------------
# Which adapter serves each half of the analysis.
#
#   mock      deterministic development/demo provider. Transcribes nothing and
#             reasons about nothing; every result it produces is flagged as a
#             mock and must be shown as demo data, never as real analysis.
#   deepgram  real speech transcription (SPEECH_TO_TEXT_PROVIDER only).
#   claude    real qualitative feedback (FEEDBACK_PROVIDER only).
#
# Selecting a real provider without its API key is a request-time error
# (ANALYSIS_NOT_CONFIGURED). The application never falls back to a mock.
SPEECH_TO_TEXT_PROVIDER=mock
FEEDBACK_PROVIDER=mock

# Deepgram. Required when SPEECH_TO_TEXT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Ask Deepgram for verbatim disfluencies ("um", "uh"). Off by default: Deepgram
# does not report back whether it honoured the request, so turning this on is
# your assertion that the configured model and plan support it. While it is off,
# filler-word statistics are omitted rather than reported as zero.
DEEPGRAM_FILLER_WORDS=false

# Claude API key. Required when FEEDBACK_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Wall-clock budget for a single provider call. One attempt per call; there is
# no automatic retry.
ANALYSIS_PROVIDER_TIMEOUT_SECONDS=120

# How long an in-flight analysis may go without progress before it is treated as
# abandoned (the process that owned it died) and the recording may be analysed
# again. Must comfortably exceed two provider calls.
ANALYSIS_STALE_AFTER_SECONDS=900

# Audio limits enforced by the upload/analysis endpoints.
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300

# Where uploaded recordings are written. Relative paths resolve against the
# process working directory; deployments should point this at a mounted volume.
# Recordings land in <root>/recordings/ under server-generated names.
STORAGE_ROOT=storage

# --- Rate limiting ---------------------------------------------------------
# New identities one client address may create per window. Every owner-scoped
# route mints an identity when the key is absent or unrecognised, so an
# unauthenticated read is a write; this is what bounds it. A request presenting
# a recognised key never touches this limit, so returning users on a shared
# address are unaffected.
RATE_LIMIT_NEW_IDENTITIES=20
RATE_LIMIT_NEW_IDENTITIES_WINDOW_SECONDS=3600

# Costly requests one *owner* may make per window: uploading, starting either
# analysis, asking for feedback, adding a key. Reading is never limited.
RATE_LIMIT_COSTLY_REQUESTS=60
RATE_LIMIT_COSTLY_REQUESTS_WINDOW_SECONDS=3600

# How many trusted proxies sit in front of the API. 0 means the peer address is
# the client and X-Forwarded-For is IGNORED — it is client-supplied, so trusting
# it by default would make the limit bypassable with one header. Set this only
# if a proxy you control appends to that header.
RATE_LIMIT_TRUSTED_PROXIES=0

# Comma-separated list of allowed browser origins.
#
# Behind the bundled proxy the frontend and the API share an origin, so CORS is
# not exercised at all; it stays configured because a deployment may still front
# the two separately.
CORS_ORIGINS=http://localhost

# --- Deployment (docker-compose) -------------------------------------------
# The public origin the browser uses. It is inlined into the frontend bundle at
# BUILD time, so changing it means rebuilding the frontend image.
PUBLIC_ORIGIN=http://localhost
# Host port the proxy publishes. It is the ONLY published port in the stack:
# the API, the web app and PostgreSQL are reachable only on the internal
# network. That is what makes RATE_LIMIT_TRUSTED_PROXIES=1 safe — publish the
# backend again and a client can set its own X-Forwarded-For.
PUBLIC_PORT=80
# PostgreSQL password. The default is a development convenience; the database
# is not reachable from the host, but set this for anything real.
POSTGRES_PASSWORD=vocallens

# --- Frontend --------------------------------------------------------------
# Public base URL of the API as reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
