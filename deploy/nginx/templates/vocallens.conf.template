# VocalLens edge proxy — the plain HTTP entry point.
#
# The only public entry point for the default deployment. Everything else — the
# API, the frontend and PostgreSQL — sits on the internal compose network with
# no published port, so this file and the partial it includes are the entire
# attack surface reachable from outside.
#
# It lives under `templates/` because the official nginx image runs `envsubst`
# over `/etc/nginx/templates/*.template` at container start. That is what lets
# the body cap and the upstreams come from compose rather than being duplicated
# here, and it is why the same file can be exercised outside Docker with
# different upstreams (see `scripts/verify-proxy.sh`).
#
# **What this file is, and is not.** It is a listener. Everything the proxy
# *does* — routing, the body cap, the forwarding header, the security headers —
# is in `common/_vocallens.inc.template`, shared with the TLS entry point in
# `templates-tls/` so the two cannot drift. What is here is what differs between
# terminating TLS and not.
#
# **No Strict-Transport-Security, and that is structural rather than
# remembered.** This server speaks HTTP; advertising HSTS from a plaintext
# listener is a claim it cannot honour, and a browser that believes it will
# refuse to reach a host that has no certificate. The directive is not in this
# file and not in the shared partial, so it exists only in the file that
# actually terminates TLS. To serve HTTPS, deploy with the TLS override — see
# `docs/architecture.md`.

# The access log, without the client's address.
#
# nginx's default `combined` format begins with `$remote_addr`. This project
# deliberately does not record who made a request — Step 10.3 keeps the address
# out of the application's own logs for the same reason, since it is the thing
# being counted rather than something worth keeping against a person. What is
# left is what an operator actually debugs with: when, what, the outcome and how
# long it took.
#
# `log_format` is an http-context directive, and it is valid here because the
# nginx image includes this file from inside `http`.
log_format vocallens '$time_iso8601 "$request" $status $body_bytes_sent $request_time';

# Next.js production does not use websockets, but a proxy that silently breaks
# one is a confusing failure to debug later. Three lines now, none later.
map $http_upgrade $vl_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${VL_LISTEN_PORT};
    server_name _;

    include ${VL_INCLUDE};
}
